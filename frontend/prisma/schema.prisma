generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model Task {
  id           String    @id @default(cuid())
  title        String
  description  String?
  status       String    // 'todo', 'in-progress', 'done'
  project      String    // 'UEF', 'Team', 'MBA', etc.
  priority     String    // 'urgent', 'high', 'medium', 'low'
  tags         String    // JSON string array
  dueDate      DateTime?
  link         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  aiSuggestion String?
}

model FocusSession {
  id          String    @id @default(cuid())
  mode        String    // 'pomodoro', 'deep-work', etc.
  duration    Int       // in seconds
  taskId      String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
}

model Transaction {
  id       String   @id @default(cuid())
  title    String
  amount   Float
  type     String   // 'income', 'expense'
  category String
  date     DateTime
  notes    String?
}

model FinancialGoal {
  id            String @id @default(cuid())
  title         String
  targetAmount  Float
  currentAmount Float  @default(0)
  color         String
}

model Habit {
  id             String @id @default(cuid())
  title          String
  icon           String
  streak         Int    @default(0)
  completedDates String // JSON string array of YYYY-MM-DD
}

model MoodEntry {
  id    String   @id @default(cuid())
  level String   // 'great', 'good', 'okay', 'stressed', 'bad'
  date  String   @unique // YYYY-MM-DD
  notes String?
}

model JournalEntry {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  tags      String?  // JSON string array
  aiSummary String?
}

model AIInsight {
  id        String   @id @default(cuid())
  type      String   // 'achievement', 'warning', 'suggestion', 'brief'
  message   String
  createdAt DateTime @default(now())
}

model Subscription {
  id           String @id @default(cuid())
  title        String
  amount       Float
  billingCycle String // 'monthly', 'annually'
  icon         String // 'terminal', 'cloud', 'brain', etc.
}

model HealthLog {
  id           String   @id @default(cuid())
  date         String   @unique // YYYY-MM-DD
  sleepHours   Float?
  waterGlasses Int?     @default(0)
  exercised    Boolean  @default(false)
  energyLevel  Int?     // 1-5 scale
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BudgetItem {
  id          String   @id @default(cuid())
  title       String
  amount      Float
  type        String   // 'expected-income', 'expected-expense'
  month       String   // 'YYYY-MM' format
  isRecurring Boolean  @default(false)
  category    String   @default("Khác")
  createdAt   DateTime @default(now())
}

model SpendingJar {
  id            String   @id @default(cuid())
  title         String               // "Tiền ăn", "Xăng xe"...
  icon          String   @default("🏦") // emoji icon
  monthlyBudget Float                // Tổng ngân sách tháng (VD: 3000000)
  startDate     String               // YYYY-MM-DD ngày bắt đầu kỳ
  daysInPeriod  Int      @default(30)  // Số ngày trong kỳ
  dailySpending String   @default("{}") // JSON: {"2026-06-01": 50000, ...}
  color         String   @default("#10b981")
  createdAt     DateTime @default(now())
}
